{
  "root": "absolute resolved locator",
  "kind": "<root>/<kind>/<id>",
  "metadata": "<root>/<kind>/<id>.meta",
  "history": "<root>/.history/<kind>/<id>/<entry_revision>.json",
  "journal": "<root>/.txn/<operation_id>.json",
  "revision_marker": "<root>/.asset-revision",
  "encoding": "UTF-8 metadata JSON; base64 history content",
  "case_sensitive": true,
  "normalization": "none",
  "reserved_paths": [".asset-revision", ".history", ".txn"],
  "containment": "resolved final path must remain below root"
}
