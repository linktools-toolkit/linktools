#!/bin/sh
set -eu
umask 077

root=/etc/certs
versions="$root/versions"
renewal="$root/.renewal"
seed=/opt/nginx-initial
acme=/opt/acme/acme.sh
mkdir -p "$versions" "$renewal"
exec 9>"$root/.acme.lock"
flock -x 9

verify() {
    directory=$1
    main=$2
    domains_file=$3
    fullchain="$directory/${main}_fullchain.pem"
    key="$directory/${main}_key.pem"
    test -s "$fullchain" && test -s "$key"
    openssl x509 -in "$fullchain" -noout -checkend 0 >/dev/null
    cert_key=$(openssl x509 -in "$fullchain" -pubkey -noout | openssl pkey -pubin -outform DER | openssl dgst -sha256)
    file_key=$(openssl pkey -in "$key" -pubout -outform DER | openssl dgst -sha256)
    test "$cert_key" = "$file_key"
    while IFS= read -r domain || test -n "$domain"; do
        test -n "$domain" || continue
        case "$domain" in
            \*.*)
                openssl x509 -in "$fullchain" -noout -ext subjectAltName |
                    tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
                    grep -Fx -- "DNS:$domain" >/dev/null ;;
            *) openssl x509 -in "$fullchain" -noout -checkhost "$domain" >/dev/null ;;
        esac
    done < "$domains_file"
}

configure() {
    main=$1
    account=$2
    "$acme" --home /opt/acme --config-home "$account" --install-cert -d "$main" \
        --cert-file "$renewal/${main}_cert.pem" \
        --key-file "$renewal/${main}_key.pem" \
        --fullchain-file "$renewal/${main}_fullchain.pem" \
        --reloadcmd ':' >/dev/null
}

activate() {
    id=$1
    directory="$versions/$id"
    main=$(cat "$directory/primary")
    port=$(cat "$directory/port")
    verify "$directory" "$main" "$directory/domains"
    previous=$(readlink "$root/live" 2>/dev/null || :)
    if test "$previous" = "versions/$id" && ! test -s /var/run/nginx.pid; then
        return 0
    fi
    if test -z "$previous" && test -s /var/run/nginx.pid; then
        echo 'Cannot change a running TLS certificate without a previous live version' >&2
        return 1
    fi
    ln -s "versions/$id" "$root/.next-$$"
    mv -Tf "$root/.next-$$" "$root/live"
    if test -s /var/run/nginx.pid; then
        if ! nginx -p /etc/nginx/ -c /etc/nginx/generated/current/nginx.conf -t ||
           ! nginx -p /etc/nginx/ -c /etc/nginx/generated/current/nginx.conf -s reload; then
            if test -n "$previous"; then
                ln -s "$previous" "$root/.next-$$"
                mv -Tf "$root/.next-$$" "$root/live"
                nginx -p /etc/nginx/ -c /etc/nginx/generated/current/nginx.conf -s reload || :
            fi
            return 1
        fi
        expected=$(openssl x509 -in "$directory/${main}_fullchain.pem" -noout -fingerprint -sha256)
        attempt=0
        while test "$attempt" -lt 30; do
            actual=$(openssl s_client -connect "127.0.0.1:$port" -servername "$main" </dev/null 2>/dev/null |
                     openssl x509 -noout -fingerprint -sha256 2>/dev/null || :)
            test "$actual" = "$expected" && return 0
            sleep 1
            attempt=$((attempt + 1))
        done
        if test -n "$previous"; then
            ln -s "$previous" "$root/.next-$$"
            mv -Tf "$root/.next-$$" "$root/live"
            nginx -p /etc/nginx/ -c /etc/nginx/generated/current/nginx.conf -s reload || :
        fi
        echo 'New TLS certificate was not served after reload' >&2
        return 1
    fi
}

case "$1" in
    check)
        shift
        main=$1
        shift
        verify "$root/live" "$main" "$1"
        ;;
    prepare)
        shift
        id=$1
        main=$2
        directory="$versions/$id"
        test -f "$directory/domains"
        test -s "$seed/certs/${main}_fullchain.pem"
        test -s "$seed/certs/${main}_key.pem"
        for name in cert key fullchain; do
            if test -f "$seed/certs/${main}_${name}.pem"; then
                cp "$seed/certs/${main}_${name}.pem" "$directory/${main}_${name}.pem"
            fi
        done
        mkdir "$directory/acme"
        cp -a "$seed/acme/." "$directory/acme/"
        verify "$directory" "$main" "$directory/domains"
        configure "$main" "$directory/acme"
        ;;
    configure)
        shift
        configure "$1" "$root/live/acme"
        ;;
    activate)
        shift
        activate "$1"
        ;;
    renew)
        if test -L "$root/live"; then
            main=$(cat "$root/live/primary")
            account="$root/live/acme"
            before=$(openssl x509 -in "$renewal/${main}_fullchain.pem" -noout -fingerprint -sha256 2>/dev/null || :)
            "$acme" --home /opt/acme --config-home "$account" --cron >/dev/null
            after=$(openssl x509 -in "$renewal/${main}_fullchain.pem" -noout -fingerprint -sha256 2>/dev/null || :)
            if test -n "$after" && test "$after" != "$before" &&
               { ! cmp -s "$renewal/${main}_fullchain.pem" "$root/live/${main}_fullchain.pem" ||
                 ! cmp -s "$renewal/${main}_key.pem" "$root/live/${main}_key.pem"; }; then
                id="renew-$(date +%s)-$$"
                directory="$versions/$id"
                mkdir "$directory"
                cp "$root/live/domains" "$root/live/primary" "$root/live/port" "$directory/"
                if test -f "$root/live/build-revision"; then
                    cp "$root/live/build-revision" "$directory/build-revision"
                fi
                cp -a "$account" "$directory/acme"
                for name in cert key fullchain; do
                    if test -s "$renewal/${main}_${name}.pem"; then
                        cp "$renewal/${main}_${name}.pem" "$directory/${main}_${name}.pem"
                    fi
                done
                verify "$directory" "$main" "$directory/domains"
                activate "$id"
            fi
        fi
        ;;
    *) echo 'Usage: nginx-certificates {check|prepare|configure|activate|renew}' >&2; exit 2 ;;
esac
