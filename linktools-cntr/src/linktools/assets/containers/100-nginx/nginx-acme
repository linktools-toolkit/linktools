#!/bin/sh
set -eu

state=$1
shift
credentials=/run/acme-secrets/dns.env

strip_credentials() {
    test -d "$state" || return 0
    for key in $(sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$credentials"); do
        find "$state" -type f -name '*.conf' -exec sed -i \
            -e "/^$key=/d" -e "/^SAVED_$key=/d" {} +
    done
}

strip_credentials
status=0
(
    set -a
    . "$credentials"
    set +a
    /opt/acme/acme.sh --home /opt/acme --config-home "$state" "$@"
) || status=$?
strip_credentials
exit "$status"
