#!/bin/sh
set -eu

# Seed only empty mounts; persisted certificates and account keys take precedence.
for name in certs acme; do
    case "$name" in
        certs) destination=/etc/certs ;;
        acme) destination=/root/.acme.sh ;;
    esac
    mkdir -p "$destination"
    if [ -z "$(ls -A "$destination")" ]; then
        cp -a "/opt/nginx-initial/$name/." "$destination/"
    fi
done

# Old installations used killall or a different nginx configuration path.
for config in /root/.acme.sh/*/*.conf; do
    [ -f "$config" ] || continue
    grep -q '^Le_Domain=' "$config" || continue
    if ! grep -qx "Le_ReloadCmd='/usr/local/bin/nginx-reload'" "$config"; then
        sed -i '/^Le_ReloadCmd=/d' "$config"
        printf "Le_ReloadCmd='/usr/local/bin/nginx-reload'\n" >> "$config"
    fi
done
