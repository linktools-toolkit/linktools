{
  "networks": {
    "nginx": {
      "name": "aio-nginx"
    },
    "safeline-ce": {
      "name": "aio-safeline-ce"
    }
  },
  "services": {
    "nginx": {
      "build": {
        "context": "<ASSETS>/100-nginx",
        "dockerfile": "<DATA>/container/dockerfile/nginx.Dockerfile"
      },
      "container_name": "aio-nginx",
      "healthcheck": {
        "interval": "5s",
        "start_interval": "1s",
        "start_period": "1s",
        "test": [
          "CMD",
          "curl",
          "--fail",
          "--silent",
          "--unix-socket",
          "/run/nginx-cntr-health.sock",
          "http://localhost/__cntr/health"
        ]
      },
      "hostname": "nginx",
      "image": "aio-nginx",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m"
        }
      },
      "networks": {
        "nginx": null,
        "safeline-ce": {
          "aliases": [
            "nginx-origin"
          ],
          "ipv4_address": "172.22.242.253"
        }
      },
      "ports": [
        "80:80",
        "443:443"
      ],
      "restart": "unless-stopped",
      "volumes": [
        "<APP_DATA>/nginx/conf.d:/etc/nginx/conf.d"
      ]
    }
  }
}
