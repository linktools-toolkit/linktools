{
  "networks": {
    "nginx": {
      "name": "aio-nginx"
    }
  },
  "services": {
    "nginx": {
      "build": {
        "context": "<ASSETS>/100-nginx",
        "dockerfile": "<DATA>/container/dockerfile/nginx.Dockerfile"
      },
      "command": [
        "nginx",
        "-p",
        "/etc/nginx/",
        "-c",
        "/etc/nginx/generated/current/nginx.conf",
        "-g",
        "daemon off;"
      ],
      "container_name": "aio-nginx",
      "environment": {
        "CF_Account_ID": "",
        "CF_Email": "",
        "CF_Key": "",
        "CF_Token": "",
        "CF_Zone_ID": ""
      },
      "healthcheck": {
        "interval": "5s",
        "start_interval": "1s",
        "start_period": "1s",
        "test": [
          "CMD",
          "curl",
          "--fail",
          "--silent",
          "--unix-socket",
          "/run/nginx-health.sock",
          "http://localhost/health"
        ]
      },
      "hostname": "nginx",
      "image": "aio-nginx",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m"
        }
      },
      "networks": {
        "nginx": null,
        "safeline-ce": {
          "aliases": [
            "nginx-origin"
          ],
          "ipv4_address": "172.22.242.253"
        }
      },
      "ports": [
        "80:80",
        "443:443"
      ],
      "restart": "unless-stopped",
      "volumes": [
        "<APP_DATA>/nginx/generated:/etc/nginx/generated:ro",
        "<APP_DATA>/nginx/certs:/etc/certs",
        "<APP_DATA>/nginx/acme:/root/.acme.sh"
      ]
    }
  }
}