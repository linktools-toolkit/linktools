  "read_file": {
    "description": "Read text or supported media; as_file sends whole files. Lists are atomic batches.\n\nRanges/metadata require one text preview: zero-based offset, default 200 lines.\ncursor excludes offset; full_metadata scans for SHA-256 and line count.",
    "metadata": {
      "linktools.ai.context_dedupe": "workspace_file_read_v2",
      "linktools.ai.effect_policy": "none",
      "linktools.ai.path_fields": [
        "path"
      ],
      "linktools.ai.plan_safe": true,
      "linktools.ai.tool_class": "filesystem.read"
    },
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "as_file": {
          "default": false,
          "type": "boolean"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "full_metadata": {
          "default": false,
          "type": "boolean"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "return_schema": {},
    "revision": 2,
    "strict": null,
    "version": 1
  },
