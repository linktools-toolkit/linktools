    "parameters": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "default": ".",
          "description": "Directory to search in, relative to the root directory.",
          "type": "string"
        },
        "pattern": {
          "description": "Glob pattern to match, relative to `path` (e.g. '*.py',\n'**/*.json'). Absolute patterns are rejected.",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
