        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "return_schema": {},
    "revision": 1,
    "strict": null,
    "version": 1
  },
